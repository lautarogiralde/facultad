function y=tramo135(t)

%Tramo 1        
%Desde t=7 hasta t=7.2

%Tramo 3
%Desde t=7.205 hasta t=7.8   

%Tramo 5
%Desde t=7.805 hasta t=8


y= 0.5*sin(188,4955592*t - 0)+ 0.7*sin(18,84955592*t - 1,570796327) + 0.3*sin(157,0796327*t - 1,047197551)+ 1*sin(94,24777961*t - 0,785398163) + 1.5*sin(31,41592654*t - 0,628318531)      

            
end
